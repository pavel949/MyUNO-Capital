# ---------------------------------------------------------------------------
# MyUNO Capital — .gitignore
# ---------------------------------------------------------------------------

# ===== Python (backend/) =====
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
# Packaging/build artifacts are anchored to backend/ so they don't clobber
# frontend source dirs like frontend/lib/.
backend/build/
backend/develop-eggs/
backend/dist/
backend/downloads/
backend/eggs/
backend/.eggs/
backend/lib/
backend/lib64/
backend/parts/
backend/sdist/
backend/var/
backend/wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual environments
.venv/
venv/
env/
ENV/
.python-version

# Test / coverage / type-checker caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
*.cover
.tox/
.nox/
.hypothesis/

# ===== Node / Next.js (frontend/) =====
node_modules/
.pnp
.pnp.js
.yarn/
.next/
out/
build/
dist/
.turbo/
*.tsbuildinfo
next-env.d.ts

# Package manager logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.npm/

# ===== Environment files =====
.env
.env.*
!.env.example
*.local

# ===== Docker =====
docker-compose.override.yml
*.pid

# ===== Local data volumes =====
postgres-data/
minio-data/
redis-data/
pgdata/
data/

# ===== Logs & temp =====
logs/
*.log
tmp/
.cache/

# ===== IDE / editors =====
.vscode/
.idea/
*.swp
*.swo
*~
*.sublime-project
*.sublime-workspace

# ===== OS files =====
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ===== Secrets / keys =====
*.pem
*.key
secrets/
.secrets/
