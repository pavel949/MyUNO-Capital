# =============================================================================
# MyUNO Capital — Environment Configuration (EXAMPLE)
# -----------------------------------------------------------------------------
# Copy this file to `.env` and fill in real values:
#     cp .env.example .env
#
# NEVER commit your real `.env` file. Only placeholders belong here.
# All variables below are consumed by docker-compose.yml, the FastAPI backend,
# the Celery worker, and the Next.js frontend.
# =============================================================================

# -----------------------------------------------------------------------------
# App
# -----------------------------------------------------------------------------
# Runtime environment: local | staging | production
APP_ENV=local
# Secret used for app-level signing (sessions, CSRF, etc.). Generate a strong
# random value, e.g.: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-please-generate-a-long-random-string
# Host port the FastAPI backend is exposed on.
BACKEND_PORT=8000
# Host port the Next.js frontend is exposed on.
FRONTEND_PORT=3000
# Comma-separated list of origins allowed by CORS (backend).
CORS_ORIGINS=http://localhost:3000
# Public base URL the frontend uses to reach the backend API.
NEXT_PUBLIC_API_URL=http://localhost:8000

# -----------------------------------------------------------------------------
# Database (PostgreSQL 16 + pgvector)
# -----------------------------------------------------------------------------
POSTGRES_USER=myuno
POSTGRES_PASSWORD=change-me-postgres-password
POSTGRES_DB=myuno_capital
# Hostname of the Postgres service. Inside Docker Compose this is the service
# name `postgres`. For local-without-docker development use `localhost`.
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# Full SQLAlchemy connection string. Must stay consistent with the values above.
# Uses the async psycopg driver.
DATABASE_URL=postgresql+psycopg://myuno:change-me-postgres-password@postgres:5432/myuno_capital
# Postgres schema the app's tables live in. Leave as "public" for a dedicated
# database. Set to a custom schema (e.g. "myuno_capital") when sharing a managed
# instance with other products — the engine pins search_path via a libpq startup
# option so it works through transaction-mode poolers (Supabase Supavisor).
DB_SCHEMA=public

# -----------------------------------------------------------------------------
# Redis (cache + Celery broker/result backend)
# -----------------------------------------------------------------------------
# Inside Docker Compose the host is the service name `redis`.
REDIS_URL=redis://redis:6379/0
# Celery uses dedicated logical DBs for broker and results.
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# -----------------------------------------------------------------------------
# MinIO / S3-compatible Object Storage
# -----------------------------------------------------------------------------
# Root credentials for the local MinIO server.
MINIO_ROOT_USER=myuno-minio
MINIO_ROOT_PASSWORD=change-me-minio-password
# S3 endpoint the backend/worker use. Inside Docker Compose this is `minio`.
S3_ENDPOINT=http://minio:9000
# Default bucket for logs, artifacts, and backups.
S3_BUCKET=myuno-artifacts
# Access credentials the application uses to talk to S3/MinIO.
# For local dev these typically match the MinIO root credentials above.
S3_ACCESS_KEY=myuno-minio
S3_SECRET_KEY=change-me-minio-password
# Region label (MinIO ignores it but the S3 SDK requires one).
S3_REGION=us-east-1

# -----------------------------------------------------------------------------
# LLM (Anthropic Claude)
# -----------------------------------------------------------------------------
# Required. Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key-here
# Default model used for agent reasoning.
DEFAULT_LLM_MODEL=claude-opus-4-8
# Cheaper/faster fallback used for routing low-complexity tasks.
LLM_FALLBACK_MODEL=claude-haiku-4-5

# -----------------------------------------------------------------------------
# Integrations (placeholders — fill only what you use)
# -----------------------------------------------------------------------------
# Payments
STRIPE_API_KEY=sk_test_your-stripe-test-key
STRIPE_WEBHOOK_SECRET=whsec_your-stripe-webhook-secret
# Source control
GITHUB_TOKEN=ghp_your-github-personal-access-token
# Ads
GOOGLE_ADS_DEVELOPER_TOKEN=your-google-ads-developer-token
GOOGLE_ADS_CLIENT_ID=your-google-ads-client-id
GOOGLE_ADS_CLIENT_SECRET=your-google-ads-client-secret
GOOGLE_ADS_REFRESH_TOKEN=your-google-ads-refresh-token
# Email
SENDGRID_API_KEY=SG.your-sendgrid-api-key

# -----------------------------------------------------------------------------
# Auth (JWT)
# -----------------------------------------------------------------------------
# Secret used to sign JWT access tokens. Generate a strong random value.
JWT_SECRET=change-me-please-generate-a-long-random-jwt-secret
# Access token lifetime in minutes.
JWT_EXPIRE_MINUTES=60
# JWT signing algorithm.
JWT_ALGORITHM=HS256
